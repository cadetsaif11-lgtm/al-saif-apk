[{"surahNumber": 101, "ayahNumber": 1, "arabicText": "ٱلْقَارِعَةُ", "translationSahih": "The Striking Calamity -", "translationUrdu": "کھڑ کھڑانے والی", "audioAyahUrl": "https://everyayah.com/data/Alafasy_128kbps/101001.mp3", "translationBangla": "করাঘাতকারী,"}, {"surahNumber": 101, "ayahNumber": 2, "arabicText": "مَا ٱلْقَارِعَةُ", "translationSahih": "What is the Striking Calamity?", "translationUrdu": "کھڑ کھڑانے والی کیا ہے؟", "audioAyahUrl": "https://everyayah.com/data/Alafasy_128kbps/101002.mp3", "translationBangla": "করাঘাতকারী কি?"}, {"surahNumber": 101, "ayahNumber": 3, "arabicText": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ", "translationSahih": "And what can make you know what is the Striking Calamity?", "translationUrdu": "اور تم کیا جانوں کھڑ کھڑانے والی کیا ہے؟", "audioAyahUrl": "https://everyayah.com/data/Alafasy_128kbps/101003.mp3", "translationBangla": "করাঘাতকারী সম্পর্কে আপনি কি জানেন ?"}, {"surahNumber": 101, "ayahNumber": 4, "arabicText": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ", "translationSahih": "It is the Day when people will be like moths, dispersed,", "translationUrdu": "(وہ قیامت ہے) جس دن لوگ ایسے ہوں گے جیسے بکھرے ہوئے پتنگے", "audioAyahUrl": "https://everyayah.com/data/Alafasy_128kbps/101004.mp3", "translationBangla": "যেদিন মানুষ হবে বিক্ষিপ্ত পতংগের মত"}, {"surahNumber": 101, "ayahNumber": 5, "arabicText": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ", "translationSahih": "And the mountains will be like wool, fluffed up.", "translationUrdu": "اور پہاڑ ایسے ہو جائیں گے جیسے دھنکی ہوئی رنگ برنگ کی اون", "audioAyahUrl": "https://everyayah.com/data/Alafasy_128kbps/101005.mp3", "translationBangla": "এবং পর্বতমালা হবে ধুনিত রঙ্গীন পশমের মত।"}, {"surahNumber": 101, "ayahNumber": 6, "arabicText": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ", "translationSahih": "Then as for one whose scales are heavy [with good deeds],", "translationUrdu": "تو جس کے (اعمال کے) وزن بھاری نکلیں گے", "audioAyahUrl": "https://everyayah.com/data/Alafasy_128kbps/101006.mp3", "translationBangla": "অতএব যার পাল্লা ভারী হবে,"}, {"surahNumber": 101, "ayahNumber": 7, "arabicText": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ", "translationSahih": "He will be in a pleasant life.", "translationUrdu": "وہ دل پسند عیش میں ہو گا", "audioAyahUrl": "https://everyayah.com/data/Alafasy_128kbps/101007.mp3", "translationBangla": "সে সুখীজীবন যাপন করবে।"}, {"surahNumber": 101, "ayahNumber": 8, "arabicText": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ", "translationSahih": "But as for one whose scales are light,", "translationUrdu": "اور جس کے وزن ہلکے نکلیں گے", "audioAyahUrl": "https://everyayah.com/data/Alafasy_128kbps/101008.mp3", "translationBangla": "আর যার পাল্লা হালকা হবে,"}, {"surahNumber": 101, "ayahNumber": 9, "arabicText": "فَأُمُّهُۥ هَاوِيَةٌۭ", "translationSahih": "His refuge will be an abyss.", "translationUrdu": "اس کا مرجع ہاویہ ہے", "audioAyahUrl": "https://everyayah.com/data/Alafasy_128kbps/101009.mp3", "translationBangla": "তার ঠিকানা হবে হাবিয়া।"}, {"surahNumber": 101, "ayahNumber": 10, "arabicText": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ", "translationSahih": "And what can make you know what that is?", "translationUrdu": "اور تم کیا سمجھے کہ ہاویہ کیا چیز ہے؟", "audioAyahUrl": "https://everyayah.com/data/Alafasy_128kbps/101010.mp3", "translationBangla": "আপনি জানেন তা কি?"}, {"surahNumber": 101, "ayahNumber": 11, "arabicText": "نَارٌ حَامِيَةٌۢ", "translationSahih": "It is a Fire, intensely hot.", "translationUrdu": "دہکتی ہوئی آگ ہے", "audioAyahUrl": "https://everyayah.com/data/Alafasy_128kbps/101011.mp3", "translationBangla": "প্রজ্জ্বলিত অগ্নি!"}]