[{"surahNumber": 112, "ayahNumber": 1, "arabicText": "قُلْ هُوَ ٱللَّهُ أَحَدٌ", "translationSahih": "Say, \"He is Allah, [who is] One,", "translationUrdu": "کہو کہ وہ (ذات پاک جس کا نام) الله (ہے) ایک ہے", "audioAyahUrl": "https://everyayah.com/data/Alafasy_128kbps/112001.mp3", "translationBangla": "বলুন, তিনি আল্লাহ, এক,"}, {"surahNumber": 112, "ayahNumber": 2, "arabicText": "ٱللَّهُ ٱلصَّمَدُ", "translationSahih": "Allah, the Eternal Refuge.", "translationUrdu": "معبود برحق جو بےنیاز ہے", "audioAyahUrl": "https://everyayah.com/data/Alafasy_128kbps/112002.mp3", "translationBangla": "আল্লাহ অমুখাপেক্ষী,"}, {"surahNumber": 112, "ayahNumber": 3, "arabicText": "لَمْ يَلِدْ وَلَمْ يُولَدْ", "translationSahih": "He neither begets nor is born,", "translationUrdu": "نہ کسی کا باپ ہے اور نہ کسی کا بیٹا", "audioAyahUrl": "https://everyayah.com/data/Alafasy_128kbps/112003.mp3", "translationBangla": "তিনি কাউকে জন্ম দেননি এবং কেউ তাকে জন্ম দেয়নি"}, {"surahNumber": 112, "ayahNumber": 4, "arabicText": "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ", "translationSahih": "Nor is there to Him any equivalent.\"", "translationUrdu": "اور کوئی اس کا ہمسر نہیں", "audioAyahUrl": "https://everyayah.com/data/Alafasy_128kbps/112004.mp3", "translationBangla": "এবং তার সমতুল্য কেউ নেই।"}]